.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

/* Logo */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 60rpx;
}

.logo-icon {
  font-size: 80rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-top: 20rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

/* Form Card */
.form-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.form-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

/* Role Selector */
.role-selector {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.role-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}

.role-btn.active {
  background: #667eea;
  border-color: #667eea;
  color: #fff;
}

/* Form Group */
.form-group {
  margin-bottom: 30rpx;
}

.form-group .label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.input-wrap {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.input-wrap .input {
  width: 100%;
  height: 100%;
  font-size: 28rpx;
}

/* Login Button */
.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn[disabled] {
  opacity: 0.7;
}

/* Role Description */
.role-desc {
  margin-top: 40rpx;
  padding: 24rpx;
  background: #f8f9ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #667eea;
}

.role-desc-title {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.role-desc-text {
  font-size: 24rpx;
  color: #999;
}
