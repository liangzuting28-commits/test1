<view class="admin-page">
  <!-- Header -->
  <view class="header">
    <view class="user-info">
      <text class="title">管理员控制台</text>
      <text class="user-role">系统管理员</text>
    </view>
    <view class="logout-btn" bindtap="doLogout">退出</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-number">{{stats.totalUsers}}</text>
      <text class="stat-label">用户总数</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.totalActivities}}</text>
      <text class="stat-label">活动总数</text>
    </view>
    <view class="stat-card">
      <text class="stat-number">{{stats.totalClubs}}</text>
      <text class="stat-label">社团总数</text>
    </view>
  </view>

  <!-- 管理菜单 -->
  <view class="menu-section">
    <text class="section-title">管理功能</text>
    <view class="menu-list">
      <view class="menu-item" bindtap="goTo" data-url="/pages/admin/user-manage/user-manage">
        <view class="menu-icon icon-bg-blue">&#x1F464;</view>
        <view class="menu-text">
          <text class="menu-label">用户管理</text>
          <text class="menu-desc">查看、添加、编辑、删除用户</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goTo" data-url="/pages/admin/add-user/add-user">
        <view class="menu-icon icon-bg-green">&#x2795;</view>
        <view class="menu-text">
          <text class="menu-label">添加用户</text>
          <text class="menu-desc">创建新的学生、教师或管理员账户</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goTo" data-url="/pages/manage-activities/manage-activities">
        <view class="menu-icon icon-bg-orange">&#x1F4CB;</view>
        <view class="menu-text">
          <text class="menu-label">活动管理</text>
          <text class="menu-desc">查看和管理所有活动</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
